# Copy to a private file; replace the examples before starting production.
# Never put Hermes model-provider API keys here. They belong in Hermes itself.
HERTS_ORIGIN=https://your-node.your-tailnet.ts.net:8443
HERTS_IDENTITY=you@example.com
HERTS_DATA_DIR=./data
HERTS_PORT=8787
# Prepared plugin folders. Defaults to ./plugins.
HERTS_PLUGINS_DIR=./plugins

# Optional: leave BOTH the URL and token settings empty for tasks-only use.
HERMES_BASE_URL=http://127.0.0.1:8788
HERMES_TOKEN_FILE=./data/backend-token
HERMES_PROFILE=default

# Optional comma-separated Hermes conversation IDs to omit from browsing.
HERMES_EXCLUDED_CONVERSATIONS=

# Local development ONLY. Keep 0 for Tailscale installations.
HERTS_DEV=0
