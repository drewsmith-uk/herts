[Unit]
Description=Hermes Desktop-compatible backend for Herts
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@HOME@
EnvironmentFile=@ENV@
Environment=@PATH@
ExecStart=@COMMAND@
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
