{
  "name": "herts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run build && npm test",
    "check:connection": "node --import tsx scripts/check-connection.ts",
    "test:installer": "python3 -m unittest discover -s tests -p \"test_installer.py\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.3",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.4.1",
    "dexie": "^4.2.0",
    "dompurify": "^3.4.15",
    "fastify": "^5.6.1",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "zod": "^4.1.11",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
