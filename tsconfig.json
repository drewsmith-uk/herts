{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@herts/plugin-api/server": [
        "./sdk/server.ts"
      ],
      "@herts/plugin-api/types": [
        "./sdk/types.ts"
      ],
      "@herts/plugin-api/client": [
        "./sdk/client.ts"
      ]
    }
  },
  "include": [
    "src",
    "server",
    "shared",
    "scripts",
    "tests",
    "*.ts",
    "plugins",
    "sdk",
    "examples"
  ]
}
